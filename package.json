{
  "name": "central-regulacao-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1 --port 5173\"",
    "server": "tsx watch server/index.ts",
    "client": "vite --host 127.0.0.1 --port 5173",
    "build": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json && vite build",
    "start": "tsx server/index.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "share": "npm run build && set HOST=0.0.0.0&& set PORT=8080&& tsx server/index.ts",
    "share:server": "set HOST=0.0.0.0&& set PORT=8080&& tsx server/index.ts",
    "import:xlsm": "tsx scripts/import-xlsm.ts"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "pg": "^8.22.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "tsx": "^4.19.2",
    "vite": "^6.0.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.1",
    "@types/pg": "^8.20.0",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "typescript": "^5.7.2",
    "xlsx": "^0.18.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
